# PostgreSQL database
DATABASE_URL="postgresql://inventory_app:replace-with-password@127.0.0.1:5432/inventory_prod?schema=public"

# Authentication and public application URL
JWT_SECRET="replace-with-a-long-random-secret"
SESSION_IDLE_TIMEOUT_MINUTES=30
NEXTAUTH_URL="https://inventory.example.com"
EAPPROVE_APP_URL="https://inventory.example.com"

# Chrome/Chromium used by the E-Approve PDF worker
CHROME_PATH="/usr/bin/google-chrome"

# SMTP used by the E-Approve email worker
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="smtp-user"
SMTP_PASS="replace-with-smtp-password"
SMTP_FROM="E-Approve <no-reply@example.com>"

# Emergency kill switches. Runtime settings remain available in E-Approve Admin.
EAPPROVE_EMAIL_DISABLED="false"
EAPPROVE_CALENDAR_DISABLED="false"
EAPPROVE_OFFICIAL_PDF_AUTO_SEND_DISABLED="false"
