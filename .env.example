# Database (SQLite path must be on a persistent disk in production)
DATABASE_URL="file:./prod.db"

# Authentication and public application URL
JWT_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="https://inventory.example.com"
EAPPROVE_APP_URL="https://inventory.example.com"

# Chrome/Chromium used by the E-Approve PDF worker
CHROME_PATH="/usr/bin/google-chrome"

# SMTP used by the E-Approve email worker
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="smtp-user"
SMTP_PASS="replace-with-smtp-password"
SMTP_FROM="E-Approve <no-reply@example.com>"
