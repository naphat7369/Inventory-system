{
  "name": "inventory-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n web,worker -c blue,magenta \"npm:dev:web\" \"npm:worker\"",
    "dev:web": "next dev",
    "worker": "node --env-file=.env scripts/eapprove-worker.mjs",
    "worker:once": "node --env-file=.env scripts/eapprove-worker.mjs --once",
    "smtp:test": "node --env-file=.env scripts/test-smtp.mjs",
    "build": "prisma generate && next build",
    "start": "next start",
    "start:web": "next start",
    "start:all": "concurrently -k -n web,worker -c blue,magenta \"npm:start:web\" \"npm:worker\"",
    "lint": "eslint",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.2.0",
    "bcryptjs": "^3.0.3",
    "concurrently": "^10.0.5",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "exceljs": "^4.4.0",
    "html5-qrcode": "^2.3.8",
    "jose": "^6.2.3",
    "lucide-react": "^1.24.0",
    "mammoth": "^1.13.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.0.11",
    "pdfjs-dist": "^4.10.38",
    "puppeteer-core": "^25.12.0",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-to-print": "^3.3.0",
    "recharts": "^3.10.1",
    "sanitize-html": "^2.17.7",
    "word-extractor": "^1.0.4",
    "xlsx": "^0.18.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prisma": "^6.2.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
